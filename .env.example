# 环境变量样例。
# 本地一条命令启动（./run.sh）无需任何环境变量：内嵌索引 + 文件态 + 默认 mock 模型。
# 以下配置主要用于 server 模式（docker compose）或自定义覆盖；按需复制为 .env，不要提交真实密钥。
# cp .env.example .env

# --- 基础设施（server 模式 / compose 使用）---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=rag
MYSQL_USER=rag
MYSQL_PASSWORD=rag
MYSQL_PORT=3306
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6379

# --- Python 核心服务（IR_ 前缀映射到 Settings）---
IR_ENVIRONMENT=dev
IR_LOG_LEVEL=INFO
IR_LOG_JSON=true
# 语料路径根：本地默认为仓库根；容器内为挂载点 /workspace
#IR_WORKSPACE_ROOT=/workspace
#IR_DATABASE_URL=mysql+aiomysql://rag:rag@mysql:3306/rag
#IR_REDIS_URL=redis://redis:6379/0
#IR_QDRANT_URL=http://qdrant:6333

# P0 默认启用 mock，无需真实 Key；联调真实模型时置为 false 并填写对应项
# （也可以直接在控制台「设置」页配置，无需 env）。
IR_MODELS_MOCK=true
IR_GENERATION_BASE_URL=http://mock-model:8001/v1
IR_GENERATION_MODEL=mock-chat
IR_GENERATION_API_KEY=
IR_EMBEDDING_BASE_URL=http://mock-model:8001/v1
IR_EMBEDDING_MODEL=mock-embedding
IR_EMBEDDING_API_KEY=
IR_RERANK_BASE_URL=http://mock-model:8001/v1
IR_RERANK_MODEL=mock-rerank
IR_RERANK_API_KEY=

# --- Go 网关（server 模式可选）---
GATEWAY_ADDR=:8080
API_UPSTREAM=http://api:8000
