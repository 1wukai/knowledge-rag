# Python 服务镜像：API 与 mock 模型共用，entrypoint 由 compose 覆盖。
FROM ghcr.io/astral-sh/uv:0.12.5-python3.12-bookworm-slim

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

COPY pyproject.toml .python-version ./
COPY src ./src
COPY data ./data
RUN uv sync --no-dev

CMD ["uv", "run", "interview-rag-api"]
